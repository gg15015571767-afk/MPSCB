# DeepSeek（必填，用于 LLM 兜底）—— 请填入 .env，勿提交真实密钥到本文件
DEEPSEEK_API_KEY=

# 飞书（启用飞书 channel 时填写，并把 agent/config.json 里 channels.feishu.enabled 改为 true）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 钉钉（启用钉钉 channel 时填写 AppKey/AppSecret）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# MPSCB 运行时数据路径（可选，默认如下）
MPSCB_DB=data/mpscb.db
MPSCB_PREF=data/preferences.json
